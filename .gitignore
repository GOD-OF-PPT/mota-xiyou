# Optional local tooling; the shipped game needs none of these directories.
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
coverage/
playwright-report/
test-results/
.cache/
.tmp/

# Machine-specific secrets, editor state, and OS metadata.
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.tmp

